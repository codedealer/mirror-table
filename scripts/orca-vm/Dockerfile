# Orca-native base image for mirror-table workspaces (SSH target).
#
# Toolchain mirrors .devcontainer/Dockerfile + .devcontainer/post-create.sh
# (the devcontainer setup is untouched and remains the VS Code fallback;
# sync this file manually if you change either). Intentional differences:
#   + openssh-server: Orca dials into this container over SSH; no `orca serve`
#   - uv, omnigent, tmux: replaced by Orca
#   + build-essential: Orca compiles orca-relay on the target at connect time
#   - the repo checkout is NOT baked in: docker-create.sh bind-mounts the host
#     checkout (devcontainer-style), so the image is toolchain-only and never
#     stale
FROM mcr.microsoft.com/devcontainers/typescript-node:24-bookworm

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      curl \
      ripgrep \
      fd-find \
      openssh-server \
      openssh-sftp-server \
 && rm -rf /var/lib/apt/lists/*

# 'fd' instead of 'fdfind'
RUN ln -s /usr/bin/fdfind /usr/bin/fd

# sshd: key auth only. Host keys are deliberately NOT kept: Debian's
# openssh-server postinst generates them at build time, and a private host
# key baked into the image would be shared by every container booted from it.
# The entrypoint runs `ssh-keygen -A` on each container's first start, so
# every workspace gets a unique host identity.
RUN rm -f /etc/ssh/ssh_host_* \
 && printf '%s\n' \
      'PermitRootLogin no' \
      'PasswordAuthentication no' \
      'KbdInteractiveAuthentication no' \
      'UsePAM no' \
      'PubkeyAuthentication yes' \
      > /etc/ssh/sshd_config.d/60-orca.conf \
 && mkdir -p /home/node/.ssh \
 && chmod 700 /home/node/.ssh \
 && chown -R node:node /home/node/.ssh

# SSH sessions do not inherit Docker's ENV, so make the toolchain reachable
# from both login shells (profile.d) and plain non-login `sh -c` sessions
# (usr/local/bin wrapper scripts — see the root section below).
RUN printf '%s\n' \
      'export PNPM_HOME="${PNPM_HOME:-/home/node/.local/share/pnpm}"' \
      'export PATH="/home/node/.local/bin:${PNPM_HOME}/bin:${PATH}"' \
      > /etc/profile.d/orca-toolchain.sh

ENV PNPM_HOME=/home/node/.local/share/pnpm \
    PATH=/home/node/.local/bin:/home/node/.local/share/pnpm/bin:${PATH}

RUN mkdir -p \
      /home/node/.pnpm-store \
      /home/node/.local/bin \
      /home/node/.local/share/pnpm \
 && chown -R node:node /home/node/.pnpm-store /home/node/.local

RUN corepack enable --install-directory /home/node/.local/bin

USER node

# Same agent CLIs and flags as .devcontainer/post-create.sh.
RUN corepack prepare pnpm@11.17.0 --activate \
 && pnpm config set store-dir /home/node/.pnpm-store \
 && pnpm add -g --ignore-scripts @earendil-works/pi-coding-agent \
 && pnpm add -g --allow-build=@github/copilot @github/copilot

# Desktop SSH key: the keypair is machine-local (generated by
# docker-base-snapshot.sh on first run); the local public half is baked in
# at build time.
COPY orca-docker-ssh_key.pub /home/node/.ssh/authorized_keys

USER root
# Unlocked (password-less) account: with UsePAM no, sshd rejects pubkey auth
# for accounts whose shadow entry is locked ('!').
RUN usermod -p '*' node
# Wrappers for non-login `sh -c` SSH sessions (sshd's default PATH includes
# /usr/local/bin); profile.d covers login shells. pnpm's cmd-shims resolve
# their payload relative to $0 without following symlinks, so these must be
# wrapper scripts, not symlinks.
RUN chmod 600 /home/node/.ssh/authorized_keys \
 && chown node:node /home/node/.ssh/authorized_keys \
 && for tool in pnpm corepack; do \
      printf '#!/bin/sh\nexec /home/node/.local/bin/%s "$@"\n' "$tool" > "/usr/local/bin/$tool"; \
      chmod 755 "/usr/local/bin/$tool"; \
    done \
 && for tool in pi copilot; do \
      printf '#!/bin/sh\nexec /home/node/.local/share/pnpm/bin/%s "$@"\n' "$tool" > "/usr/local/bin/$tool"; \
      chmod 755 "/usr/local/bin/$tool"; \
    done

COPY entrypoint.sh /usr/local/bin/orca-docker-ssh-entrypoint
RUN chmod 755 /usr/local/bin/orca-docker-ssh-entrypoint
ENTRYPOINT ["/usr/local/bin/orca-docker-ssh-entrypoint"]