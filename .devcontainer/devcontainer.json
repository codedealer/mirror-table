// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/typescript-node
{
  "name": "mirror-table",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/typescript-node:24-bookworm",
  "remoteUser": "node",
  "updateRemoteUserUID": true,
  "containerEnv": {
    "NUXT_HOST": "0.0.0.0",
    "NUXT_PORT": "3000",
    "npm_config_store_dir": "/home/node/.pnpm-store"
  },
  "remoteEnv": {
    "no_proxy": "localhost,127.0.0.1,0.0.0.0,.local,vscode-remote",
    "NO_PROXY": "localhost,127.0.0.1,0.0.0.0,.local,vscode-remote"
  },
  // Features to add to the dev container. More info: https://containers.dev/features.
  // "features": {},
  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "Nuxt dev"
    }
  },
  "mounts": [
    "source=mirror-table-pnpm-store,target=/home/node/.pnpm-store,type=volume",
    "source=${localEnv:HOME}/.copilot,target=/home/node/.copilot,type=bind,consistency=cached"
  ],
  // Use 'postCreateCommand' to run commands after the container is created.
  "postCreateCommand": "sudo corepack enable && corepack prepare pnpm@10.18.0 --activate && sudo mkdir -p /home/node/.pnpm-store && sudo chown -R node:node /home/node/.pnpm-store && pnpm install",
  "postStartCommand": "sudo mkdir -p /home/node/.pnpm-store && sudo chown -R node:node /home/node/.pnpm-store",
  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      "extensions": [
        "Vue.volar",
        "EditorConfig.EditorConfig",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
  // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
  // "remoteUser": "root"
}
